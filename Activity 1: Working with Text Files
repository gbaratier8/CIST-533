#Working with Text Files (.txt) and Removing False Positive Results
#Adapted from Programming Historian Lesson
#https://programminghistorian.org/en/lessons/working-with-text-files

#Replace textfiletitle with a txt file of interest
file = open('textfiletitle.txt' , 'r' , encoding = 'utf-8')
text = file.read()
file.close()


text_normalized = text.lower().split('.')
text_parsed = open('textfiletitleresults.txt' , 'w' , encoding = 'utf-8')

false_positive = 0


for line in text_normalized:
    
    if 'disabled' in line or 'disability' in line:
        if 'disabled vehicle' in line:
            print(line)
            false_positive += 1
        else:
            text_parsed.write(line + '\n')

    if 'deaf' in line:
        if 'fell on deaf ears' in line:
            print(line)
            false_positive += 1
        else:
            text_parsed.write(line + '\n')

    if 'blind' in line:
        if 'blind faith' in line or 'blind to' in line or 'blinding' in line:
            print(line)
            false_positive += 1
        else:
            text_parsed.write(line + '\n')

    if 'crippled' in line:
        if 'crippled finances' in line:
            print(line)
            false_positive += 1
        else:
            text_parsed.write(line + '/n'+'/n')

print ('Number of false positives:' , false_positive)
  
text_parsed.close()
